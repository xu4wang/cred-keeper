#!/bin/sh
# Resolve symlinks so the relative src/ path works when installed via npm link.
self="$0"
while [ -L "$self" ]; do d=$(dirname "$self"); self=$(readlink "$self"); case "$self" in /*) ;; *) self="$d/$self" ;; esac; done
exec node --disable-warning=ExperimentalWarning "$(dirname "$self")/../src/cli.ts" "$@"
